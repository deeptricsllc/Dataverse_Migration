# -----------------------------------------------------------------------------
# Dataverse Migration Platform — environment configuration
# Copy to .env for local use. Never commit real secrets.
# -----------------------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Public URL of the app. Used for the OAuth redirect URI and origin checks.
# With `npm run dev` (Vite on :5173) use http://localhost:5173
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
LOG_PRETTY=true

# --- Database ------------------------------------------------------------------
# PostgreSQL (recommended for shared/production use). Database must be UTF-8.
# DATABASE_URL=postgres://user:password@localhost:5432/dataverse_migration
# Without DATABASE_URL an embedded PostgreSQL (PGlite) is stored here:
PGLITE_DATA_DIR=./.data/pglite

# --- Sessions ------------------------------------------------------------------
# Required in production: >= 32 random characters (e.g. `openssl rand -base64 48`).
# Also used to encrypt the server-side Microsoft token cache.
SESSION_SECRET=
SESSION_TTL_HOURS=12
# true behind HTTPS (default true in production)
COOKIE_SECURE=false

# --- Demo mode -------------------------------------------------------------------
# Simulated Dataverse environments + "Continue with demo account". Defaults to true
# outside production. Set false once Microsoft sign-in is configured if not needed.
DEMO_MODE=true
DEMO_LATENCY_MS=12

# --- Microsoft Entra ID (see docs/MICROSOFT_SETUP.md) --------------------------------
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# "organizations" = any work/school tenant (multi-tenant SaaS), or your tenant GUID.
ENTRA_TENANT_ID=organizations
# Defaults to ${APP_BASE_URL}/api/auth/callback
# ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Optional comma-separated allow-list of tenant IDs that may sign in.
ALLOWED_TENANT_IDS=
# Optional comma-separated emails that become ADMIN (first user of an org is ADMIN).
ADMIN_EMAILS=

# --- Dataverse -------------------------------------------------------------------
DATAVERSE_DISCOVERY_URL=https://globaldisco.crm.dynamics.com
DATAVERSE_API_VERSION=v9.2
# Enrich environment type/region via the Power Platform admin API (needs extra consent).
POWER_PLATFORM_ENRICHMENT=false
# Allow ADMIN users to request MSCRM.BypassBusinessLogicExecution (audited). Default off.
ALLOW_BUSINESS_LOGIC_BYPASS=false

# --- Real-tenant certification safety ------------------------------------------------
# true  = every Dataverse READ is allowed; every Dataverse WRITE is refused by the server
#         (POST/PATCH/PUT/DELETE), regardless of what the UI offers. Migrations cannot start.
# Use this while certifying the platform against a real Microsoft tenant. See
# docs/REAL_TENANT_CERTIFICATION.md. Simulated demo environments are not affected.
REAL_TENANT_READ_ONLY=false

# --- Background jobs -----------------------------------------------------------------
# Run the job worker inside the web process (required with PGlite).
# With PostgreSQL you may set false and run `npm run worker` separately.
RUN_WORKER=true
WORKER_POLL_MS=1000
